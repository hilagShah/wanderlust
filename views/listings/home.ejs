<% layout("/layouts/boilerplate.ejs") %>
<section class="hero-section">
    <div class="hero-content">
        <h1>Find your next stay</h1>
        <p>
            Discover unique homes, villas, apartments and unforgettable
            experiences around the world.
        </p>

        <a href="/listings" class="btn btn-danger hero-btn">
            Explore Listings
        </a>
    </div>
</section>

<section class="features-section">
    <div class="row text-center">

        <div class="col-md-4 mb-4">
            <div class="feature-card">
                <i class="fa-solid fa-house"></i>
                <h4>Unique Homes</h4>
                <p>Stay in handpicked homes and apartments.</p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="feature-card">
                <i class="fa-solid fa-shield-heart"></i>
                <h4>Safe Booking</h4>
                <p>Secure reservations and trusted hosts.</p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="feature-card">
                <i class="fa-solid fa-earth-asia"></i>
                <h4>Worldwide</h4>
                <p>Explore destinations across the globe.</p>
            </div>
        </div>

    </div>
</section>

<section class="stats-section">
    <div class="row text-center">

        <div class="col-md-4">
            <h2>1000+</h2>
            <p>Listings</p>
        </div>

        <div class="col-md-4">
            <h2>500+</h2>
            <p>Happy Guests</p>
        </div>

        <div class="col-md-4">
            <h2>50+</h2>
            <p>Cities Covered</p>
        </div>

    </div>
</section>